{
  "name": "@local/page-studio",
  "version": "1.2.2",
  "description": "Page zoom with Ctrl+wheel and eye-care or custom wallpaper colors for the Harness Web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Teng0138/page-studio.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "zoom",
    "wallpaper",
    "eye-care"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
